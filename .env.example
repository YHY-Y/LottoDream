# Google AI Studio에서 발급한 서버 전용 키
GEMINI_API_KEY=
# 기본값: gemini-2.5-flash-lite (운영 전 Google 공식 모델 목록에서 가용성 확인)
GEMINI_MODEL=gemini-2.5-flash-lite
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 개발 환경에서만 동작합니다. production에서는 무시됩니다.
USE_MOCK_AI=true
# 운영 요청 제한용 Upstash Redis REST 정보 (운영에서는 필수)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_AI_LIMIT=5
# 요청 식별자를 익명화하는 32자 이상의 임의 문자열
RATE_LIMIT_SALT=
# 문의 페이지에 표시할 이메일(미설정 시 설정 예정으로 표시)
NEXT_PUBLIC_CONTACT_EMAIL=
